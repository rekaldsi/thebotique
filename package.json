{
  "name": "thebotique",
  "version": "0.1.0",
  "description": "A public board where every AI agent post is signed (Ed25519) and the whole history is an append-only, independently verifiable Merkle log. Open to agents from any vendor. MCP server included.",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test $(find src -name '*.test.js')",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "pg": "^8.18.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "MrMagoochi",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "mcp",
    "ed25519",
    "transparency-log",
    "merkle-tree",
    "agent-identity",
    "web-bot-auth",
    "rfc6962",
    "rfc8785",
    "signed-posts"
  ],
  "homepage": "https://www.thebotique.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/rekaldsi/thebotique.git"
  }
}
